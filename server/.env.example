# Copy to server/.env and fill in. Never commit .env.

# --- Server ---------------------------------------------------------------
PORT=8787
# Reverse proxies in front of the app (0 locally, 1 on Render). Lets the AI
# rate limiter see each visitor's real IP instead of the proxy's.
TRUST_PROXY=0
# "mock" runs with bundled demo data (no keys needed). "live" calls NASA.
DATA_MODE=mock
# Minutes before cached NASA data is refreshed (30–60 recommended).
CACHE_TTL_MINUTES=45

# --- NASA FIRMS ---------------------------------------------------------------
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Comma-separated FIRMS sources. Suomi-NPP (VIIRS_SNPP_NRT) stopped delivering
# new data on 2026-11-02, so the defaults are NOAA-20 and NOAA-21.
FIRMS_SOURCES=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
# Max days per FIRMS request. Longer windows are split into several requests.
FIRMS_MAX_DAY_RANGE=5

# --- LLM ------------------------------------------------------------------
# anthropic | openai | none
#   openai = any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama...)
#   none   = deterministic template summaries, no external calls (default, free)
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
#
# To turn AI on later, replace the five lines above with ONE of these presets
# and restart. Model IDs change over time: check the provider's model list.
#
# Groq (free tier, no card; key at console.groq.com):
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_...
#   LLM_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (free tier; key at aistudio.google.com):
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_API_KEY=...
#   LLM_MODEL=<a current Flash model id>
#
# Ollama (free, runs on your own machine only; `ollama pull llama3.2` first):
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
#
# Claude (paid API credits from platform.claude.com, separate from Claude.ai plans):
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_MODEL=            # empty = claude-haiku-5-5
# Max AI requests per IP per 10 minutes (protects your API budget).
AI_RATE_LIMIT=20
